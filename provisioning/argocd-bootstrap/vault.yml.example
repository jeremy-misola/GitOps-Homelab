# Ansible Vault file for storing sensitive bootstrap tokens
# Copy this file to vault.yml and encrypt it:
#   ansible-vault encrypt vault.yml
#
# Then edit with:
#   ansible-vault edit vault.yml
#
# Use in playbook:
#   ansible-playbook install-argocd.yaml -i inventory.yml --ask-vault-pass

# Doppler service token with read access to fetch the ESO token
# Create a service token in Doppler with minimal scope needed
doppler_bootstrap_token: "dp.st.your-service-token-here"