# Proxmox Connection (non-sensitive)
pm_api_url      = "https://192.168.0.230:8006/api2/json"
pm_tls_insecure = true
target_node     = "proxmox"

# Template Configuration
template_name = "ubuntu-2404-template"
storage_pool  = "local-lvm"

# Network Configuration
network_bridge = "vmbr0"
gateway        = "192.168.0.1"
nameserver     = "192.168.0.1"

# Cloud-Init Configuration
ci_user = "jurassicjey"
ssh_public_keys = <<EOF_KEYS
ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPePe7odIztvlzr5RQJ8fyV9kxfHcyzwYmQDxDtYtHw0 jeremy@Jeremys-Mac-mini.local
ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFRgisKGZLdiAvV9c2mn+eFtZ6tZMO28futLysncYvBV jurassicjey@archlinux
EOF_KEYS

# Shared K3s configuration
k3s_version       = "v1.31.12+k3s1"
extra_server_args = "--disable=traefik --disable=servicelb --disable=local-storage"
extra_agent_args  = ""

# Cluster Configuration
clusters = {
  prod = {
    control_plane = {
      ips       = ["192.168.0.210", "192.168.0.211", "192.168.0.212"]
      cores     = 2
      memory    = 6144
      disk_size = "100G"
    }
    worker = {
      ips       = ["192.168.0.213", "192.168.0.214", "192.168.0.215"]
      cores     = 6
      memory    = 16384
      disk_size = "200G"
    }
  }
  dev = {
    control_plane = {
      ips       = ["192.168.0.220"]
      cores     = 2
      memory    = 6144
      disk_size = "100G"
    }
    worker = {
      ips       = ["192.168.0.221", "192.168.0.222"]
      cores     = 4
      memory    = 20480
      disk_size = "200G"
    }
  }
}

# ==============================================================================
# SENSITIVE VARIABLES - Set via Doppler
# ==============================================================================
# The following secrets must be set in Doppler (Doppler requires uppercase names):
#
#   PM_API_TOKEN_ID     = "root@pam!your-token-id"
#   PM_API_TOKEN_SECRET = "your-token-secret"
#   PROD_K3S_TOKEN      = "your-production-k3s-cluster-token"
#   DEV_K3S_TOKEN       = "your-development-k3s-cluster-token"
#
# Run Terraform with:
#   doppler run -- sh -c 'TF_VAR_prod_k3s_token=$PROD_K3S_TOKEN TF_VAR_dev_k3s_token=$DEV_K3S_TOKEN terraform apply'
#
# Note: Doppler requires uppercase secret names (A-Z, 0-9, _). Since TF_VAR_prod_k3s_token
# and TF_VAR_dev_k3s_token contain lowercase characters, we use PROD_K3S_TOKEN and
# DEV_K3S_TOKEN in Doppler and map them inside the shell command.
# ==============================================================================
