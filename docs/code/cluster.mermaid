flowchart TD
    User["User Request"] --> Ingress["Network Edge (MetalLB/Envoy)"]
    LE["Let's Encrypt (CA)"] -.->|TLS Certificates| Ingress

    subgraph Cluster["K3s Cluster"]
        direction TB
        Ingress --> Auth{"Authentik (SSO)"}
        
        Auth -->|Authorized| Apps["Application Workloads"]
        
        Apps --> Storage["Storage (Longhorn/Garage)"]
        
        %% Control Plane Services
        ESO["External Secrets"] -.->|Injects| Apps
        Apps -.->|Telemetry| LGTM["Observability (LGTM)"]
    end

    classDef success fill:#90EE90,stroke:#2E7D32,color:#000
    classDef info fill:#81D4FA,stroke:#0277BD,color:#000
    classDef warning fill:#FFE082,stroke:#F57C00,color:#000
    classDef note fill:#F5F5F5,stroke:#9E9E9E,color:#616161,stroke-dasharray:3

    class Apps success
    class Ingress info
    class Auth,ESO warning
    class Storage,LGTM,LE note